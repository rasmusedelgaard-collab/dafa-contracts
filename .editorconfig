# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,sln,slnx,config,resx}]
indent_size = 2

[*.sln]
indent_style = tab
end_of_line = crlf

[*.{cmd,bat,ps1}]
end_of_line = crlf

[*.bicep]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.dc.html]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[Makefile]
indent_style = tab
