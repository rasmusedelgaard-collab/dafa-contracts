{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Auth": {
    "Mode": "Dev",
    "Dev": { "AccessCode": "" },
    "Cookie": { "AllowInsecure": false },
    "Entra": { "AutoProvision": true }
  },
  "Database": { "Provider": "Sqlite" },
  "ConnectionStrings": { "Default": "" },
  "Seed": { "DemoData": true },
  "DataProtection": { "KeysPath": "App_Data/keys" },
  "Jobs": { "Enabled": true, "IntervalMinutes": 60, "StartupDelaySeconds": 30 },

  "Documents": { "Provider": "Local", "LocalPath": "App_Data/files" },
  "Analyzer": { "Provider": "Heuristic" },
  "Suppliers": { "Provider": "Seed" },
  "Notifications": { "Provider": "Outbox", "Sender": "" },
  "Directory": { "Provider": "Seeded" },
  "Signature": { "Provider": "None" },
  "App": { "BaseUrl": "" }
}
