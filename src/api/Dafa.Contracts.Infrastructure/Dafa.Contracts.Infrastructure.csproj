<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Dafa.Contracts.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gives IConfiguration, IHttpClientFactory, hosting abstractions without extra packages. -->
